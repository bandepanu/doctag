{
  "name": "docx-pi",
  "version": "0.1.0",
  "description": "DocX Framework validator for the pi coding agent: tree-sitter, multi-language, Core-tier enforcement (docslim/docdeps/doctype/docpure) that cages AI agents against slop.",
  "keywords": [
    "pi-package",
    "docx",
    "ai-agent",
    "linting",
    "tree-sitter",
    "governance"
  ],
  "license": "MIT",
  "bin": {
    "docx-pi": "dist/cli.js"
  },
  "main": "dist/extension.js",
  "pi": {
    "extensions": [
      "dist/extension.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node dist/cli.js examples/python/ledger_router.py && node dist/cli.js examples/python/bad_example.py; test $? -eq 1"
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.25.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "skills",
    "prompts",
    "schema",
    "hooks",
    "ci",
    "scripts",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  }
}
